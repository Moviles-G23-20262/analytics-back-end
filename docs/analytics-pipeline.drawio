<mxfile host="app.diagrams.net">
  <diagram name="Analytics pipeline" id="analytics-pipeline">
    <mxGraphModel dx="1212" dy="675" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" value="Campus Swap - Analytics pipeline design" vertex="1">
          <mxGeometry height="36" width="800" x="20" y="15" as="geometry" />
