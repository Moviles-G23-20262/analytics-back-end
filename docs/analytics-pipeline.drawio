        <mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="&lt;font style=&quot;font-size:40px&quot;&gt;1&lt;/font&gt;&lt;br&gt;Collection" vertex="1">
