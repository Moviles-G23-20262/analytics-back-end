        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="&lt;font style=&quot;font-size:40px&quot;&gt;2&lt;/font&gt;&lt;br&gt;Ingestion" vertex="1">
          <mxGeometry height="170" width="130" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f3eef7;strokeColor=#9673a6;" value="" vertex="1">
          <mxGeometry height="240" width="1000" x="20" y="520" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="&lt;font style=&quot;font-size:40px&quot;&gt;3&lt;/font&gt;&lt;br&gt;Storage" vertex="1">
          <mxGeometry height="240" width="130" x="20" y="520" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eef6ec;strokeColor=#82b366;" value="" vertex="1">
          <mxGeometry height="353" width="1000" x="20" y="820" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="&lt;font style=&quot;font-size:40px&quot;&gt;4&lt;/font&gt;&lt;br&gt;Processing&lt;br&gt;and serving" vertex="1">
          <mxGeometry height="353" width="130" x="20" y="820" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="120" width="1000" x="20" y="1233" as="geometry" />
        </mxCell>
        <mxCell id="b5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="&lt;font style=&quot;font-size:40px&quot;&gt;5&lt;/font&gt;&lt;br&gt;Consumption" vertex="1">
          <mxGeometry height="120" width="130" x="20" y="1233" as="geometry" />
        </mxCell>
        <mxCell id="rs" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;dashed=1;dashPattern=8 4;" value="" vertex="1">
          <mxGeometry height="210" width="1000" x="20" y="1413" as="geometry" />
        </mxCell>
        <mxCell id="bs" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="&lt;font style=&quot;font-size:22px&quot;&gt;Side path&lt;/font&gt;&lt;br&gt;Telemetry&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(independent of&lt;br&gt;stages 1 to 5)&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="130" x="20" y="1413" as="geometry" />
        </mxCell>
        <mxCell id="flutter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=12;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Flutter | Kotlin mobile app&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Writes marketplace data (listings, chats, exchanges, wishlist)&lt;br&gt;• Emits usage events (views, searches, contacts, wishlist, notifications)&lt;br&gt;• Reads analytics results (JSON) for in-app features&lt;br&gt;• Includes the Firebase Crashlytics SDK" vertex="1">
          <mxGeometry height="130" width="720" x="220" y="85" as="geometry" />
        </mxCell>
        <mxCell id="nest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=12;" value="&lt;b style=&quot;font-size:15px&quot;&gt;NestJS + Prisma - main back-end&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; The only writer to the database&lt;br&gt;&amp;#8226; POST /analytics-events (event ingestion)&lt;br&gt;&amp;#8226; CRUD for users, materials, chats, exchanges, wishlist, notifications, meeting points&lt;br&gt;&amp;#8226; The Prisma schema is the source of truth" vertex="1">
          <mxGeometry height="140" width="720" x="220" y="305" as="geometry" />
        </mxCell>
        <mxCell id="pg" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontStyle=1;fontSize=15;rounded=1;" value="PostgreSQL - single database" vertex="1">
          <mxGeometry height="210" width="720" x="220" y="535" as="geometry" />
        </mxCell>
        <mxCell id="pg-ops" parent="pg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Operational tables&lt;/b&gt; (written by NestJS)&lt;br&gt;&lt;br&gt;User, Material, ChatRoom, Message, Exchange, MeetingPoint, WishlistItem, Notification" vertex="1">
          <mxGeometry height="150" width="345" x="15" y="45" as="geometry" />
        </mxCell>
        <mxCell id="pg-events" parent="pg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;AnalyticsEvent&lt;/b&gt; (event log)&lt;br&gt;&lt;br&gt;LISTING_VIEW, SEARCH, CONTACT_SELLER, WISHLIST_ADD / REMOVE, NOTIFICATION_SENT / OPENED, plus a metadata JSON column" vertex="1">
          <mxGeometry height="150" width="330" x="375" y="45" as="geometry" />
        </mxCell>
        <mxCell id="django" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=15;rounded=1;" value="Django analytics back-end (read-only)" vertex="1">
          <mxGeometry height="323" width="720" x="220" y="835" as="geometry" />
        </mxCell>
        <mxCell id="dj-read" parent="django" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Read layer&lt;/b&gt;&lt;br&gt;ReadOnlyRouter (writes raise an error, migrations disabled) + unmanaged models that mirror the Prisma schema" vertex="1">
          <mxGeometry height="85" width="345" x="15" y="48" as="geometry" />
        </mxCell>
        <mxCell id="dj-dash" parent="django" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Analytics dashboard&lt;/b&gt;&lt;br&gt;web pages served by Django" vertex="1">
          <mxGeometry height="85" width="330" x="375" y="48" as="geometry" />
        </mxCell>
        <mxCell id="dj-views" parent="django" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Analytics views&lt;/b&gt; - one per business question&lt;br&gt;&lt;br&gt;/analytics/categories/ (BQ6)&lt;br&gt;/analytics/activity-times/ (BQ5)&lt;br&gt;/analytics/wishlist-conversion/ (BQ7)&lt;br&gt;/analytics/meeting-points/ (BQ12)&lt;br&gt;/analytics/buyer-journey-funnel/ (BQ2)&lt;br&gt;more are added as each BQ is implemented" vertex="1">
          <mxGeometry height="160" width="690" x="15" y="148" as="geometry" />
        </mxCell>
        <mxCell id="team" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;fontSize=12;" value="&lt;b&gt;Team and stakeholders&lt;/b&gt; (web browser)&lt;br&gt;open the analytics dashboard" vertex="1">
          <mxGeometry height="90" width="720" x="220" y="1248" as="geometry" />
        </mxCell>
        <mxCell id="crash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" value="&lt;b&gt;Firebase Crashlytics&lt;/b&gt;&lt;br&gt;managed by Google&lt;br&gt;receives crash and device telemetry from the app&#39;s Firebase SDK" vertex="1">
          <mxGeometry height="90" width="213" x="220" y="1428" as="geometry" />
        </mxCell>
        <mxCell id="console" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" value="&lt;b&gt;Firebase console&lt;/b&gt;&lt;br&gt;built-in crash dashboard" vertex="1">
          <mxGeometry height="90" width="213" x="473" y="1428" as="geometry" />
        </mxCell>
        <mxCell id="devs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;fontSize=12;" value="&lt;b&gt;Development team&lt;/b&gt;&lt;br&gt;(web browser)" vertex="1">
          <mxGeometry height="90" width="213" x="726" y="1428" as="geometry" />
        </mxCell>
        <mxCell id="bq1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;BQ1 is answered here:&lt;/b&gt; crashes by screen, OS version and device model. Crashlytics collects this automatically through the SDK, and neither PostgreSQL nor Django can capture it. There is no link to Django by design." vertex="1">
          <mxGeometry height="75" width="720" x="220" y="1533" as="geometry" />
        </mxCell>
        <mxCell id="why" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Why one database?&lt;/b&gt; Most business questions (BQ6 to BQ11) join operational data (materials, exchanges, users, wishlist, notifications) with usage events, so the analytics back-end needs both. A single PostgreSQL database avoids copying data between systems (no ETL step). NestJS is the only writer and Django only reads, using a SELECT-only database role." vertex="1">
          <mxGeometry height="85" width="1000" x="20" y="1643" as="geometry" />
        </mxCell>
        <mxCell id="lbl-left" parent="1" style="text;html=1;rotation=270;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;" value="Crash and device telemetry (Firebase SDK)" vertex="1">
          <mxGeometry height="20" width="300" x="20" y="750" as="geometry" />
        </mxCell>
        <mxCell id="lbl-right" parent="1" style="text;html=1;rotation=270;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;" value="Analytics results (JSON) for in-app features" vertex="1">
          <mxGeometry height="20" width="300" x="842" y="550" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="flutter" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="nest" value="HTTPS: writes + events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="nest" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="pg" value="Prisma: read + write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="pg" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="django" value="SQL SELECT only">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="django" style="endArrow=block;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="team" value="Dashboard in the browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="django" style="endArrow=block;html=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="flutter" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="965" y="996" />
              <mxPoint x="965" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="flutter" style="endArrow=block;html=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="crash" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="150" />
              <mxPoint x="200" y="1473" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="crash" style="endArrow=block;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="console" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="console" style="endArrow=block;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="devs" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
